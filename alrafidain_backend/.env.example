# Legacy compatibility template.
# Prefer using .env.local.example, .env.production.example, and .env.test.example.

SECRET_KEY=change-me
DEBUG=True
ENVIRONMENT=local
ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=alrafidain_db
DB_USER=alrafidain_user
DB_PASSWORD=alrafidain_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis (for Django Channels)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Embedding
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_VECTOR_DIMENSION=384

# DeepSeek / RAG
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60
RAG_DEFAULT_TOP_K=6
RAG_MAX_TOP_K=12
RAG_MIN_CONFIDENCE=0.45
RAG_REQUIRE_SOURCES=True
RAG_MAX_CONTEXT_CHUNKS=5
RAG_MAX_QUERY_LENGTH=2000
RAG_MAX_ANSWER_LENGTH=4000
RAG_EXPORT_MAX_ROWS=10000

# Observability
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Phase 12E — Dataset export anonymization salt
# Set to a random secret value in production.
EXPORT_HASH_SALT=change-me-for-production
