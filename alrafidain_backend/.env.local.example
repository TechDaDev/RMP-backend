# Local development environment
ENVIRONMENT=local
DEBUG=True
SECRET_KEY=local-dev-secret-key-change-me
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

DB_NAME=alrafidain_db
DB_USER=alrafidain_user
DB_PASSWORD=alrafidain_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis (Django Channels)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Embedding
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_VECTOR_DIMENSION=384

# DeepSeek / RAG
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60
RAG_DEFAULT_TOP_K=6
RAG_MAX_TOP_K=12

# Dataset export anonymization salt
EXPORT_HASH_SALT=local-export-salt-change-me

# Email (defaults to console backend unless overridden)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
