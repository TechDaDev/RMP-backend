# Production environment
ENVIRONMENT=production
DEBUG=False
SECRET_KEY=<required-strong-secret>
EXPORT_HASH_SALT=<required-strong-random-salt>

ALLOWED_HOSTS=<required-comma-separated-hosts>
CSRF_TRUSTED_ORIGINS=https://<required-domain>

DB_NAME=<required>
DB_USER=<required>
DB_PASSWORD=<required>
DB_HOST=<required>
DB_PORT=5432

# Redis (Django Channels)
REDIS_HOST=<required>
REDIS_PORT=6379
# Alternative if your deployment uses a URL-based Redis config
# REDIS_URL=rediss://<user>:<password>@<host>:<port>/<db>

CORS_ALLOWED_ORIGINS=https://<required-frontend-origin>

# Embedding / RAG
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_VECTOR_DIMENSION=384
DEEPSEEK_API_KEY=<required-if-rag-enabled>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60
RAG_DEFAULT_TOP_K=6
RAG_MAX_TOP_K=12

# Email (configure for SMTP provider)
EMAIL_HOST=<required>
EMAIL_PORT=587
EMAIL_HOST_USER=<required>
EMAIL_HOST_PASSWORD=<required>
EMAIL_USE_TLS=True
